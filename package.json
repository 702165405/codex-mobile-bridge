{
  "name": "codex-mobile-bridge-desktop",
  "version": "0.2.0-beta.7",
  "description": "Codex App 手机网关桌面启动器",
  "author": "try2love",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node --test tests/desktop.test.cjs tests/notifications-ui.test.cjs",
    "test:windows-app": "node scripts/smoke-windows.cjs",
    "icons:desktop": "electron scripts/build-icons.cjs",
    "pack:desktop": "electron-builder --dir --publish never",
    "build:windows": "electron-builder --win nsis zip --x64 --publish never",
    "test:pairing": "electron scripts/smoke-pairing.cjs",
    "test:updater": "node --test tests/updater.test.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  },
  "build": {
    "appId": "io.github.try2love.codexmobilebridge",
    "productName": "Codex Mobile Bridge",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**",
      "web/i18n.js",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "dist/gateway",
        "to": "gateway"
      },
      {
        "from": "dist/update-version.json",
        "to": "update-version.json"
      }
    ],
    "mac": {
      "icon": "desktop/assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "artifactName": "Codex-Mobile-Bridge-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Codex-Mobile-Bridge-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Codex-Mobile-Bridge-${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
